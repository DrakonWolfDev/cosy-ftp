{
  "name": "cosy-ftp",
  "version": "0.2.0",
  "private": true,
  "description": "A calm two-pane file transfer client for Windows and Linux",
  "homepage": "https://github.com/DrakonWolfDev/cosy-ftp",
  "desktopName": "dev.cosyftp.desktop.desktop",
  "repository": {
    "type": "git",
    "url": "https://github.com/DrakonWolfDev/cosy-ftp.git"
  },
  "author": "Cosy FTP contributors",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.5.0"
  },
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "npm run build && electron .",
    "start": "electron .",
    "build": "tsc -p tsconfig.backend.json && vite build && node scripts/third-party-notices.cjs && node scripts/build-info.cjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "package": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "icons": "node scripts/generate-icons.cjs",
    "test:desktop": "npm run build && tsx scripts/desktop-smoke.ts",
    "test:packaged": "tsx scripts/desktop-smoke.ts --packaged",
    "test:stress": "tsx scripts/stress.ts"
  },
  "dependencies": {
    "basic-ftp": "^6.2.3",
    "ssh2": "^1.17.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@axe-core/playwright": "^4.14.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ssh2": "^1.15.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.0.0",
    "playwright": "^1.56.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0"
  },
  "build": {
    "appId": "dev.cosyftp.desktop",
    "productName": "Cosy FTP",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build/icon.png",
      "build/THIRD_PARTY_NOTICES.txt",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "syncDesktopName": true,
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network",
      "maintainer": "Cosy FTP contributors"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
